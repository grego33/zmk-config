#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        letters {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&mt ESCAPE TAB   &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL        &kp A  &kp S  &kp D     &kp F  &kp G        &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&mt LSHFT ENTER  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &mt LEFT_SHIFT ENTER
                               &kp LGUI  &mo 1  &kp SPACE    &kp SPACE  &mo 2  &kp RALT
            >;
        };

        symbols {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TILDE  &kp EXCLAMATION  &kp AT                &kp HASH          &kp DOLLAR      &kp PERCENT      &kp CARET       &kp AMPS         &kp ASTRK          &none                  &none             &trans
&trans     &kp LESS_THAN    &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp BACKSLASH    &kp SLASH       &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp GREATER_THAN  &trans
&trans     &none            &none                 &trans            &none           &none            &kp UNDERSCORE  &kp MINUS        &kp PLUS           &kp EQUAL              &none             &trans
                                                  &kp LGUI          &trans          &kp SPACE        &kp SPACE       &trans           &kp RALT
            >;
        };

        num_nav {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none   &kp N1  &kp N2  &kp N3    &kp N4  &kp N5       &kp N6              &kp N7    &kp N8         &kp N9     &kp N0     &kp BSPC
&trans  &none   &none   &none     &none   &none        &kp LA(LEFT_ARROW)  &kp LEFT  &kp DOWN       &kp UP     &kp RIGHT  &kp RA(RIGHT)
&trans  &none   &none   &none     &none   &none        &none               &kp HOME  &kp PAGE_DOWN  &kp PG_UP  &kp END    &none
                        &kp LGUI  &trans  &kp SPACE    &kp SPACE           &trans    &kp RALT
            >;
        };

        func {
            bindings = <
&none         &none         &none         &none         &none         &none             &kp F1  &kp F2   &kp F3   &kp F4   &none  &none
&none         &none         &none         &none         &none         &none             &kp F5  &kp F6   &kp F7   &kp F8   &none  &none
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &studio_unlock    &kp F9  &kp F10  &kp F11  &kp F12  &none  &none
                                          &none         &none         &none             &none   &none    &none
            >;
        };
    };
};
